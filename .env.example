# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY_1 is the only key the app calls at runtime - there is no
# automatic cycling/failover to other keys anymore. GEMINI_API_KEY_2 is a
# manual fallback only: if key 1 gets rate-limited or blocked, swap its
# value into GEMINI_API_KEY_1 yourself and restart. Don't add GEMINI_API_KEY_3+,
# they're ignored. A bare GEMINI_API_KEY also still works if _1 isn't set.
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=second_gemini_api_key_here

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_secret_key_here

# Database (PostgreSQL)
# For native (non-Docker) runs: point this at your own local/remote Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/profu_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Only used by docker-compose.yml, to configure the containerized Postgres
# (db service) and build the web service's DATABASE_URL automatically.
# Not read by the app itself. Pick your own values — these are not shared
# with anyone else's database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=profu_db

# Waitlist landing page ("Cadoul Matematic"), served at /cadoul-matematic.
# It's mounted as a Flask blueprint from waitlist/app.py, which loads its
# OWN .env file (waitlist/.env) for its Supabase/Stripe/Resend credentials —
# nothing to add here. Copy waitlist/.env.example to waitlist/.env and see
# that file for what each variable does. Left unconfigured, the page still
# works locally in dry-run mode: signups are appended to local .jsonl files
# instead of Supabase, VIP checkout shows a "payment not available yet"
# message instead of calling Stripe, and notification emails are logged
# instead of sent.

# Set to 1 to work on the UI without calling Google at all (canned replies).
# Leave unset in production: with a real key configured, a blocked key must
# surface as an error, not as invented exercises a teacher might print.
AI_MOCK=0
