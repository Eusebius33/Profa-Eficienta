# Gemini API Configuration
# Get your API keys from Google AI Studio: https://aistudio.google.com/
# Each new project on gemini gives 1 api key with 20 reqests, you need 10 projects to get 10 API keys
# Add one per free-tier account (up to GEMINI_API_KEY_10). secondary/gemini_keys.py
# cycles to the next key automatically once one hits its request limit.
# A single GEMINI_API_KEY also still works if you only have one.
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=second_gemini_api_key_here
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_secret_key_here

# Database (PostgreSQL)
# For native (non-Docker) runs: point this at your own local/remote Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/profu_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Only used by docker-compose.yml, to configure the containerized Postgres
# (db service) and build the web service's DATABASE_URL automatically.
# Not read by the app itself. Pick your own values — these are not shared
# with anyone else's database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=profu_db
