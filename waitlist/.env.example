# Absolute URL of the deployed site (used for canonical link, Open Graph tags,
# and Stripe redirect URLs). Set this to your real Render URL once deployed.
SITE_URL=https://profa-eficienta.onrender.com

# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_KEY is the "service_role" secret key, NOT the anon/public key —
# it is only ever used server-side in app.py and must never be exposed to the browser.
# Leave both unset to run locally in dry-run mode (signups are appended to a
# local .jsonl file instead of a database, so you can test the full flow
# before creating a Supabase project).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe (Dashboard -> Developers -> API keys). Use the "sk_test_..." secret
# key while testing — Stripe test mode uses card 4242 4242 4242 4242, any
# future expiry, any CVC. Switch to "sk_live_..." only once you're ready to
# take real payments. Leave unset and the VIP form shows a clean "payment
# not available yet" message instead of crashing.
STRIPE_SECRET_KEY=

# Dashboard -> Developers -> Webhooks -> Add endpoint -> POST {SITE_URL}/api/stripe-webhook
# -> select event "checkout.session.completed" -> copy the "Signing secret" here.
# This is what actually confirms payment and records the VIP signup — the
# browser redirect back to /vip-success is just the user-facing thank-you page.
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com) sends every email this app sends: the "new signup"
# notifications (free/WhatsApp/VIP) and the customer-facing invoice/receipt
# email. NOT SMTP — Render's free tier blocks outbound SMTP ports (25/465/
# 587) entirely as of Sept 2025, so Gmail-SMTP-style sending cannot work on
# a free Render service regardless of credentials. Resend sends over HTTPS,
# which isn't blocked.
#
# Free account at resend.com gives you a working key immediately, no domain
# verification needed to start (uses their shared onboarding@resend.dev
# sender). Once you're sending real volume, verify your own domain in
# Resend and point RESEND_FROM_EMAIL at an address on it.
#
# Leave RESEND_API_KEY unset and emails are just logged to the console
# instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where "new signup" notifications are sent (your inbox, not the visitor's).
NOTIFY_EMAIL=
